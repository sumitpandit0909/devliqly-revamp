HOST=0.0.0.0
PORT=1337

# Public address of the CMS (leave empty for local development)
PUBLIC_URL=
# Sites allowed to call the API from the browser
CORS_ORIGINS=https://www.devliqly.in,https://devliqly.in,http://localhost:5173,http://localhost:4173

# Secrets: generate fresh random values for production, e.g. node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database: SQLite locally; in production use Postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/devliqly_cms
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Vercel Deploy Hook URL: rebuilds www.devliqly.in when posts change
SITE_DEPLOY_HOOK=
