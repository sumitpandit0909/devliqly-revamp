HOST=0.0.0.0
PORT=1337

# Public address of the CMS (leave empty for local development)
PUBLIC_URL=
# Sites allowed to call the API from the browser
CORS_ORIGINS=https://www.devliqly.in,https://devliqly.in,http://localhost:5173,http://localhost:4173

# Secrets: generate fresh random values for production, e.g. node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database: SQLite locally; Neon Postgres in production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MIN=0

# Image uploads: Cloudflare R2 in production; leave R2_BUCKET empty to store in public/uploads locally
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public address of the bucket (custom domain connected in R2)
R2_PUBLIC_URL=https://media.devliqly.in

# Vercel Deploy Hook URL: rebuilds www.devliqly.in when posts change
SITE_DEPLOY_HOOK=
