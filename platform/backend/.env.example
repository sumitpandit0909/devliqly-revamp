# Copy to .env for local development. Production values are set in Render, never committed.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000

# The app's connection: role platform_app, which row-level security applies to
DATABASE_URL=postgresql://platform_app@127.0.0.1:55432/platform_dev
# Migrations connect as the table owner
MIGRATION_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/platform_dev

# Production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# WhatsApp number, from the Meta app. With WHATSAPP_DRY_RUN on, nothing is sent; the local secret below lets
# scripts/simulate_whatsapp.py sign messages.
WHATSAPP_LINE_ID=local-line
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=local-app-secret
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_DRY_RUN=true
