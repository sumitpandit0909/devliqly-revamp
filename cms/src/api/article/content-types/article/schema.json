{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Blog posts shown at devliqly.in/blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 120 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "required": true, "maxLength": 280 },
    "category": {
      "type": "enumeration",
      "enum": ["AI Agents", "Chatbots", "Voice", "Automation", "Company"],
      "default": "AI Agents",
      "required": true
    },
    "cover": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "content": { "type": "blocks", "required": true },
    "author": { "type": "string", "default": "Team Devliqly" }
  }
}
