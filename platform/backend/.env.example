# Copy to .env for local development. Production values are set in Render, never committed.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000

# The app's connection: role platform_app, which row-level security applies to
DATABASE_URL=postgresql://platform_app@127.0.0.1:55432/platform_dev
# Migrations connect as the table owner
MIGRATION_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/platform_dev

# Production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# WhatsApp number, from the Meta app. With WHATSAPP_DRY_RUN on, nothing is sent; the local secret below lets
# scripts/simulate_whatsapp.py sign messages.
WHATSAPP_LINE_ID=local-line
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=local-app-secret
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_DRY_RUN=true
# Customers connecting their own number (Embedded Signup). See docs/meta-app-review.md.
META_APP_ID=
META_SIGNUP_CONFIG_ID=
# Required in production once customers can connect numbers. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# gemini, anthropic, openrouter, or fake to make up cards locally without an API key
AI_PROVIDER=fake
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# With OPENROUTER_API_KEY set, voice notes go to OPENROUTER_VOICE_MODEL when the main model can't hear
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_VOICE_MODEL=google/gemini-2.5-flash-lite

# Private Cloudflare R2 bucket for card photos. Left empty, development stores them in .uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Follow-up email. With EMAIL_DRY_RUN on, nothing is sent.
EMAIL_FROM=
EMAIL_DRY_RUN=true
# Through Gmail or another mail server. For Gmail use an app password, and EMAIL_FROM can be a "Send mail as" alias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Or through Resend, used when SMTP_HOST is empty
RESEND_API_KEY=
